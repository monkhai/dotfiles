theme = light:Vercel Light,dark:Vercel

# scroll one line up / down
keybind = command+shift+up=scroll_page_lines:-1
keybind = command+shift+down=scroll_page_lines:1

# icon
macos-icon = xray

# ---- panes / splits ----
# create
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
# navigate
keybind = super+alt+left=goto_split:left
keybind = super+alt+right=goto_split:right
keybind = super+alt+up=goto_split:up
keybind = super+alt+down=goto_split:down
keybind = super+alt+h=goto_split:left
keybind = super+alt+j=goto_split:down
keybind = super+alt+k=goto_split:up
keybind = super+alt+l=goto_split:right
keybind = super+[=goto_split:previous
keybind = super+]=goto_split:next
# resize (10 cells per press)
keybind = super+ctrl+left=resize_split:left,10
keybind = super+ctrl+right=resize_split:right,10
keybind = super+ctrl+up=resize_split:up,10
keybind = super+ctrl+down=resize_split:down,10
# equalize all panes / zoom current pane
keybind = super+shift+l=equalize_splits
keybind = super+shift+enter=toggle_split_zoom
