// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "debugger": {
        "dock": "right"
    },
    "cli_default_open_behavior": "existing_window",
    "outline_panel": {
        "dock": "right"
    },
    "collaboration_panel": {
        "dock": "right"
    },
    "terminal": {
        "font_family": "JetBrains Mono",
        "dock": "right",
        "minimum_contrast": 50.0
    },
    "colorize_brackets": true,
    "indent_guides": {
        "coloring": "indent_aware"
    },
    "ui_font_weight": 500.0,
    "buffer_font_weight": 300.0,
    "diff_view_style": "unified",
    "show_edit_predictions": false,
    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },
    "git_panel": {
        "group_by": "staging",
        "show_count_badge": true,
        "file_icons": true,
        "tree_view": true,
        "default_width": 360.0,
        "status_style": "icon",
        "dock": "right",
    },
    "ui_font_family": "JetBrains Mono",
    "agent": {
        "expand_terminal_card": false,
        "message_editor_min_lines": 2,
        "play_sound_when_agent_done": "always",
        "thinking_display": "always_collapsed",
        "sandbox_permissions": {
            "allow_unsandboxed": true,
            "write_paths": [
                {
                    "requested": "/Users/yohaiwiener/.config/zed",
                    "resolved": "/Users/yohaiwiener/.config/zed"
                }
            ]
        },
        "notify_when_agent_waiting": "never",
        "tool_permissions": {
            "default": "allow",
            "tools": {
                "delete_path": {
                    "default": "allow",
                },
                "terminal": {
                    "default": "allow",
                },
                "edit_file": {
                    "default": "allow",
                    "always_allow": [
                        {
                            "pattern": "^packages/edsdk/"
                        },
                        {
                            "pattern": "^assembly/visualizer/\\.zed/"
                        }
                    ],
                },
            },
        },
        "default_model": {
            "speed": "fast",
            "effort": "xhigh",
            "provider": "openai-subscribed",
            "model": "gpt-5.6-sol",
            "enable_thinking": true,
        },
        "dock": "left",
        "favorite_models": [
            {
                "provider": "openai-subscribed",
                "model": "gpt-6-astra",
                "enable_thinking": true,
                "effort": "medium"
            }
        ],
        "model_parameters": [],
    },
    "agent_servers": {
        "claude-acp": {
            "default_config_options": {
                "mode": "bypassPermissions",
                "fast": true
            },
            "type": "registry"
        }
    },
    "session": {
        "trust_all_worktrees": true,
    },
    "vim_mode": true,
    "project_panel": {
        "dock": "right",
        "auto_fold_dirs": false,
    },
    "relative_line_numbers": "enabled",
    "gutter": {
        "line_numbers": true,
    },
    "buffer_font_fallbacks": [
        "monospace"
    ],
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "auto_indent_on_paste": true,
    "linked_edits": true,
    "use_on_type_format": true,
    "show_whitespaces": "none",
    "ensure_final_newline_on_save": false,
    "preferred_line_length": 120,
    "hard_tabs": false,
    "tab_size": 2,
    "base_keymap": "VSCode",
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                },
                "javascript": {
                    "updateImportsOnFileMove": {
                        "enabled": "always"
                    }
                }
            },
            "enable_lsp_tasks": true
        },
        "typescript-language-server": {
            "initialization_options": {
                "diagnosticsIgnoredCodes": [
                    80001
                ],
            },
        },
    },
    "prettier": {
        "allowed": false,
    },
    "languages": {
        "JavaScript": {
            "formatter": [],
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
        "JSX": {
            "formatter": [],
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
        "TypeScript": {
            "formatter": [],
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
        "TSX": {
            "formatter": [],
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
        "Svelte": {
            "formatter": [],
            "code_actions_on_format": {
                "source.fixAll.eslint": true,
            },
        },
    },
    "theme": {
        "mode": "system",
        "light": "Vercel Light",
        "dark": "Vercel Dark",
    },
}